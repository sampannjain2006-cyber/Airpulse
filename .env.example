# AirPulse Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# --- General ---
NODE_ENV=development
PORT=3001

# --- Database ---
# PostgreSQL connection string (with PostGIS)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/airpulse

# --- CORS ---
# Allowed frontend origin (Vite dev server default)
CORS_ORIGIN=http://localhost:5173

# --- ML Service ---
# Python ML service URL (Phase 3+)
ML_SERVICE_URL=http://localhost:5001

# --- External APIs (Phase 1+) ---
# REQUIRED for station + observation ingestion from OpenAQ India:
# Get a free key at https://openaq.org/register
OPENAQ_API_KEY=
# OPENWEATHER_API_KEY=

# --- Google Services & Cloud Integration (Feature 15) ---
# Optional: Google Maps & Air Quality API Key for server-side geocoding & fallback model
GOOGLE_MAPS_API_KEY=
# Optional: Google OAuth 2.0 credentials for direct Google Tasks API integration
# Get credentials in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/google/auth/callback

# --- IoT (Phase 2+) ---
# IOT_DEVICE_KEYS=airpulse-proto-001
